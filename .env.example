# ---------------------------------------------------------------------------
# Mongal Chandra Vidyapith — environment template
# Copy to .env.local for development. Never commit a real .env.local.
# ---------------------------------------------------------------------------

APP_URL=https://mongal-chandra-vidyapith.vercel.app/
NODE_ENV=production

SITE_ROLE=portal

# Paste your own Atlas connection string here. Never commit a real value.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
# mongodb://127.0.0.1:27017

MONGODB_DATABASE=mcv

# Generate fresh values, e.g. `openssl rand -hex 32`. Never reuse the examples.
CSRF_SECRET=<generate-a-64-character-hex-secret>
IP_HASH_SECRET=<generate-a-64-character-hex-secret>

# Session lifetime in hours (configurable per the school's policy).
SESSION_TTL_HOURS=12

# Login abuse protection.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

MAX_UPLOAD_BYTES=10485760
