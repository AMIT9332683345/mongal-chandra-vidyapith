# ---------------------------------------------------------------------------
# Mongal Chandra Vidyapith — environment template
# Copy to .env.local for development. Never commit a real .env.local.
# ---------------------------------------------------------------------------

# Public origin, used for canonical URLs, the sitemap and absolute links.
# In the split deployment this is the public site (Vercel); on the portal host
# it is still the public site, not the portal's own address.
APP_URL=http://localhost:3000
NODE_ENV=development

# Which half this deployment is.
#   site   — the public website (default; local development)
#   portal — the authenticated host; its copy of the public pages is not indexed
SITE_ROLE=site

# MongoDB connection string.
#   Development : `npm run db:start` serves a real local MongoDB on port 27017.
#   Production  : the Atlas SRV string, copied from Atlas → Connect → Drivers.
#                 Atlas → Network Access must allow the build and runtime hosts
#                 (0.0.0.0/0 covers Vercel and Render) or the first query fails.
MONGODB_URI=mongodb://127.0.0.1:27017

# Database the application reads and writes. Keep it separate per environment so
# a staging deploy cannot touch production records. Uploaded files live in
# GridFS inside this same database, so a backup of it includes the documents.
MONGODB_DATABASE=mongal_chandra_vidyapith

# Secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Two different values. Every secret here is consumed by something; there is no
# decorative one. Rotating CSRF_SECRET invalidates outstanding form and CSRF
# tokens (open forms must be reloaded). Rotating IP_HASH_SECRET orphans the
# abuse-counter history, i.e. starts the rate limits fresh.
CSRF_SECRET=
IP_HASH_SECRET=

# Session lifetime in hours (configurable per the school's policy).
SESSION_TTL_HOURS=12

# Login abuse protection.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Ceiling for a single uploaded file, in bytes (default 10 MB). The limit is
# enforced before the bytes reach GridFS; the hosting platform may impose a
# lower request-body limit of its own.
MAX_UPLOAD_BYTES=10485760

# Only when the portal runs on a different host from the public site — the
# Vercel + Render split. Set it to the portal's origin (no trailing slash) on
# both deployments so the "Sign in" links leave the public origin. Empty means
# same origin. Next inlines NEXT_PUBLIC_* at build time: changing it needs a
# rebuild, not just a restart.
NEXT_PUBLIC_PORTAL_ORIGIN=

# --- Optional integrations -------------------------------------------------
# Leave blank until the school provides real credentials. The application
# degrades to "not configured" and never simulates a successful send.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Payment provider (test mode first). Payments are disabled while blank.
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
